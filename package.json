{
  "name": "cpc-hub-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/templates.mjs && node scripts/browser.mjs",
    "check": "node scripts/db-types.mjs --check && tsc --noEmit && tsc --noEmit -p browser/tsconfig.json",
    "test": "tsx --test tests/*.test.ts tests/browser/*.test.ts",
    "dev": "npm run build && wrangler dev -c wrangler.jsonc -c workers/validator/wrangler.jsonc -c workers/images/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply cpc-hub-catalog --local",
    "pretest": "npm run build",
    "lint": "eslint src workers/*/*.ts browser tests --max-warnings 0",
    "coverage": "npm run build && c8 node --import tsx --test tests/*.test.ts tests/browser/*.test.ts",
    "verify": "npm run build && npm run check && npm run lint && npm run coverage",
    "types:db": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "allprofanity": "2.4.0",
    "busboy": "^1.6.0",
    "dom-serializer": "3.1.1",
    "hono": "^4.10.0",
    "htmlparser2": "12.0.0",
    "marked": "^16.4.0",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.17.0",
    "transliteration": "2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "swagger-ui-dist": "^5.33.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.45.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
