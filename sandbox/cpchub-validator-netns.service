[Unit]
Description=Empty network namespace for CPC Hub validation
Before=cpchub-validator.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'test -e /run/netns/cpchub-validator || exec /usr/sbin/ip netns add cpchub-validator'
ExecStop=/usr/sbin/ip netns delete cpchub-validator

[Install]
WantedBy=multi-user.target
