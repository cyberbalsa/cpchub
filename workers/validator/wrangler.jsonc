{
  "name": "cpc-hub-validator",
  "main": "index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 12000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
