{
  "name": "cpc-hub-image-validator",
  "main": "index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "images": {
    "binding": "IMAGES"
  },
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
