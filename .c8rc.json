{
  "all": true,
  "src": [
    "src",
    "workers/images",
    "workers/validator",
    "browser"
  ],
  "include": [
    "src/**/*.ts",
    "workers/images/*.ts",
    "workers/validator/*.ts",
    "browser/**/*.ts"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/.wrangler/**",
    "src/templates.generated.js"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "text",
    "html",
    "lcov",
    "json",
    "json-summary"
  ],
  "check-coverage": true,
  "per-file": true,
  "lines": 100,
  "statements": 100,
  "functions": 100,
  "branches": 100
}
