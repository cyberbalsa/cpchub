[Unit]
Description=CPC Hub upload result collector
Requires=cpchub-app.service
After=cpchub-app.service

[Container]
Image=localhost/cpchub:production
Pull=never
ContainerName=cpchub-uploads
Network=cpchub.network
EnvironmentFile=%h/config/app.env
UserNS=keep-id:uid=10001,gid=10001
Volume=/var/lib/cpchub-validation/incoming:/var/lib/cpchub-validation/incoming:rw
Volume=/var/lib/cpchub-validation/results:/var/lib/cpchub-validation/results:ro
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=192m,mode=1777
NoNewPrivileges=true
DropCapability=all
Exec=python manage.py process_upload_jobs --loop

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
