[Unit]
Description=CPC Hub Cloudflare Tunnel origin
Requires=cpchub-app.service
After=cpchub-app.service

[Container]
Image=docker.io/nginxinc/nginx-unprivileged:stable-alpine
ContainerName=cpchub-edge
Network=cpchub.network
PublishPort=127.0.0.1:8080:8080
Volume=%h/app/deploy/cloudflare/nginx.conf:/etc/nginx/nginx.conf:ro,Z
Volume=%h/app/deploy/cloudflare/start-nginx.sh:/etc/nginx/start.sh:ro,Z
Entrypoint=/bin/sh
Exec=/etc/nginx/start.sh
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=32m,mode=1777
NoNewPrivileges=true
DropCapability=all
HealthCmd=wget --quiet --spider http://127.0.0.1:8080/healthz
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
