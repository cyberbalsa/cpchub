[Unit]
Description=CPC Hub PostgreSQL

[Container]
Image=docker.io/library/postgres:17-alpine
ContainerName=cpchub-db
Network=cpchub.network
NetworkAlias=db
EnvironmentFile=%h/config/db.env
Volume=cpchub-postgres.volume:/var/lib/postgresql/data
HealthCmd=pg_isready -U cpchub -d cpchub
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
