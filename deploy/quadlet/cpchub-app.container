[Unit]
Description=CPC Hub Django application
Requires=cpchub-db.service
After=cpchub-db.service

[Container]
Image=localhost/cpchub:production
Pull=never
ContainerName=cpchub-app
Network=cpchub.network
NetworkAlias=web
EnvironmentFile=%h/config/app.env
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=256m,mode=1777
NoNewPrivileges=true
DropCapability=all
Exec=gunicorn --config deploy/gunicorn.conf.py config.wsgi:application
HealthCmd=python -c "import urllib.request; r=urllib.request.Request('http://127.0.0.1:8000/health/',headers={'X-Forwarded-Proto':'https'}); urllib.request.urlopen(r).read()"
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill
Notify=healthy

[Service]
ExecStartPre=/usr/bin/podman run --rm --network cpchub --env-file %h/config/app.env localhost/cpchub:production python manage.py migrate --noinput
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
