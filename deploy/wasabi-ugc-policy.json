{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectCpcBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ManageUploadedFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject",
        "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/ugc/releases/*",
        "arn:aws:s3:::__BUCKET__/ugc/screenshots/*"
      ]
    }
  ]
}
