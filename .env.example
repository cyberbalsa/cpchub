# Copy to .env. Use a long random SECRET_KEY and an alphanumeric/hex DB password.
SECRET_KEY=
POSTGRES_PASSWORD=
DEBUG=1
PUBLIC_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,cpchub.net
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Only enable behind a proxy that replaces forwarded headers. Use its private subnet.
TRUST_PROXY=0
TRUSTED_PROXY_CIDRS=
# Register a Discord app with the callback below; use your localhost callback in development.
# https://cpchub.net/accounts/discord/login/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# https://steamcommunity.com/dev/apikey (domain: cpchub.net)
STEAM_API_KEY=
# Public Ko-fi profile URL, e.g. https://ko-fi.com/yourname (not an API key).
KOFI_PAGE_URL=https://ko-fi.com/cpchub
MAX_UPLOAD_BYTES=104857600
# Uploaded releases and screenshots only. Static assets stay local.
# Use local for offline development; switch to wasabi after migrating existing uploads.
MEDIA_STORAGE=local
WASABI_BUCKET_NAME=
WASABI_REGION=us-east-1
WASABI_ENDPOINT_URL=https://s3.us-east-1.wasabisys.com
# Restricted application keys, never root keys.
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_SIGNED_URL_SECONDS=300

# URLs per sitemap page; regenerated daily. Maximum 10000.
SITEMAP_PAGE_SIZE=1000
